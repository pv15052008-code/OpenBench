SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Secret. Server only. Never put this in the app or the repo.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Optional: without it, AI features use rule-based fallbacks
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: without it, notifications stay in-app
RESEND_API_KEY=
EMAIL_FROM=OpenBench <noreply@your-domain.example>
APP_URL=https://openbench.vercel.app
# Long random string; the GitHub Action sends it to /cron/tick
CRON_SECRET=
ALLOWED_ORIGINS=https://openbench.vercel.app,http://localhost:8081
